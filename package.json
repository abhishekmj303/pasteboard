{
  "name": "pasteboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node server.js",
    "build": "esbuild src/main.js --bundle --minify --format=esm --outfile=public/main.js",
    "dev": "esbuild src/main.js --bundle --format=esm --sourcemap --outfile=public/main.js --watch=forever & node --watch server.js"
  },
  "dependencies": {
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-code-block-lowlight": "^3.32.3",
    "@tiptap/extension-collaboration": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-list": "^3.32.3",
    "@tiptap/extensions": "^3.32.3",
    "@tiptap/markdown": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@tiptap/y-tiptap": "^3.1.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide": "^1.69.0"
  }
}
